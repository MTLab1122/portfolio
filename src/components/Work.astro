---
import { Icon } from "astro-icon/components";
import { projects } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="work" class="work-section border-t border-line px-5 py-16 sm:px-10">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <SectionHeading eyebrow="Work" title="Selected builds." />
    <a
      href="https://github.com/MTLab1122"
      target="_blank"
      rel="noopener noreferrer"
      class="reveal inline-flex items-center gap-2 rounded-pill border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-ink"
    >
      All repos on GitHub
      <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>

  <div class="work-track-shell mt-10 overflow-hidden">
  <div class="work-track grid gap-5 md:grid-cols-2">
    {
      projects.map((project) => (
        <article
          class={`reveal project-card group flex min-h-[17rem] flex-col justify-between rounded-card border p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(20,21,15,0.06)] ${
            project.featured ? "border-ink bg-ink text-paper" : "border-line bg-paper-dim text-ink"
          }`}
        >
          <div>
            <div class="flex items-start justify-between gap-4">
              <a href={`${baseUrl}projects/${project.slug}`} class="block">
                <p class={`font-mono text-[0.62rem] uppercase tracking-[0.16em] ${project.featured ? "text-paper/70" : "text-muted"}`}>
                  Case study
                </p>
                <h3 class={`mt-3 font-display text-2xl font-semibold leading-tight ${project.featured ? "text-paper" : "text-ink"}`}>
                  {project.title}
                </h3>
              </a>
              <span
                class={`grid h-9 w-9 shrink-0 place-items-center rounded-full transition-colors ${
                  project.featured ? "bg-lime text-ink" : "bg-paper text-ink group-hover:bg-lime"
                }`}
              >
                <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
              </span>
            </div>

            <p class={`mt-4 text-sm leading-relaxed ${project.featured ? "text-paper/75" : "text-ink/70"}`}>{project.description}</p>
          </div>

          <div class="mt-6 space-y-4">
            <div class="flex items-center justify-between text-xs uppercase tracking-[0.16em]">
              <span class={`font-mono ${project.featured ? "text-paper/70" : "text-muted"}`}>Result</span>
              <span class={`font-display text-sm ${project.featured ? "text-lime" : "text-ink"}`}>Fast + clear</span>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2">
              {project.tags.map((tag) => (
                <span
                  class={`rounded-pill px-3 py-1.5 text-[0.62rem] font-mono uppercase tracking-[0.14em] ${
                    project.featured ? "bg-ink-soft text-paper/80" : "bg-paper text-ink/70"
                  }`}
                >
                  {tag}
                </span>
              ))}
              <a href={`${baseUrl}projects/${project.slug}`} class={`text-xs font-semibold ${project.featured ? "text-lime" : "text-ink"}`}>Read case study</a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  </div>
</section>
