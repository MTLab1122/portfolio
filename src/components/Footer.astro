---
import { Icon } from "astro-icon/components";
import { person, nav } from "../data/profile";

const year = new Date().getFullYear();
const rawBaseUrl = import.meta.env.BASE_URL ?? "/";
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<footer class="border-t border-line/60 px-5 sm:px-10 py-10">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <!-- Brand & Copyright -->
    <div>
      <div class="flex items-center gap-2">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-lime text-[0.65rem] font-bold text-ink">
          MT
        </span>
        <span class="font-display text-sm font-bold text-ink">{person.name}</span>
      </div>
      <p class="mt-2 font-mono text-xs text-muted">
        © {year} Muhammad Talha. Engineered with Astro & Tailwind CSS.
      </p>
    </div>

    <!-- Quick Footer Navigation -->
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-muted" aria-label="Footer navigation">
      {
        nav.map((item) => {
          const resolvedHref = item.href.startsWith("/")
            ? `${baseUrl}${item.href.replace(/^\/+/, "")}`
            : item.href;

          return (
            <a href={resolvedHref} class="hover:text-ink transition-colors">
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Back to top CTA & System Beacon -->
    <div class="flex items-center gap-4">
      <span class="inline-flex items-center gap-1.5 text-[0.65rem] font-mono text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        100% Static & Fast
      </span>

      <a
        href="#top"
        class="inline-flex items-center gap-1 rounded-pill border border-line bg-paper px-3 py-1.5 text-xs font-semibold text-ink transition-all hover:border-ink hover:bg-white hover:-translate-y-0.5 shadow-2xs"
        aria-label="Back to top of page"
      >
        <span>Top</span>
        <Icon name="lucide:arrow-up" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
</footer>
