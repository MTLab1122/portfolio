---
import { Icon } from "astro-icon/components";
import { skills } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const groupIcons: Record<string, string> = {
  "Languages & Frameworks": "lucide:code-2",
  "Design & Productivity": "lucide:pen-tool",
  "Currently learning": "lucide:sparkles",
};
---

<section id="skills" class="border-t border-line px-5 py-16 sm:px-10">
  <SectionHeading eyebrow="Skills" title="The tools behind the work." />

  <div class="mt-10 grid gap-4 md:grid-cols-3">
    {
      Object.entries(skills).map(([group, items]) => (
        <div class="reveal rounded-card border border-line bg-paper-dim p-6 transition-transform duration-200 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(20,21,15,0.05)]">
          <div class="mb-5 flex items-center gap-2 text-ink">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-lime">
              <Icon name={groupIcons[group] ?? "lucide:circle"} class="h-4 w-4 text-ink" />
            </span>
            <h3 class="font-display text-base font-semibold">{group}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {items.map((item) => (
              <span class="rounded-pill bg-paper px-3 py-1.5 text-sm font-medium text-ink/80">{item}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
