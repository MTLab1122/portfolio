---
import { Icon } from "astro-icon/components";
import { person, education, languages } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="border-t border-line px-5 py-16 sm:px-10">
  <SectionHeading eyebrow="About" title="Design-minded builder. Clear thinker." />

  <div class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="reveal rounded-card border border-line bg-paper-dim p-6 sm:p-8">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-muted">Why I work this way</p>
      <p class="mt-5 max-w-xl text-2xl font-medium leading-tight text-ink sm:text-3xl">
        I create interfaces that look premium, communicate clearly, and help people decide faster.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-card bg-paper p-4">
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">UI</span>
          <p class="mt-3 font-display text-xl font-semibold text-ink">Clean systems</p>
        </div>
        <div class="rounded-card bg-paper p-4">
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">Code</span>
          <p class="mt-3 font-display text-xl font-semibold text-ink">Fast builds</p>
        </div>
        <div class="rounded-card bg-paper p-4">
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">Result</span>
          <p class="mt-3 font-display text-xl font-semibold text-ink">Trust + clarity</p>
        </div>
      </div>
    </div>

    <div class="reveal space-y-4">
      <div class="rounded-card bg-paper-dim p-6">
        <div class="mb-4 flex items-center gap-2 text-muted">
          <Icon name="lucide:graduation-cap" class="h-4 w-4" />
          <span class="font-mono text-xs uppercase tracking-[0.15em]">Education</span>
        </div>
        <ul class="space-y-3">
          {
            education.slice(0, 2).map((e) => (
              <li>
                <p class="font-display font-semibold text-ink">{e.degree}</p>
                <p class="text-sm text-muted">{e.school}</p>
                <p class="text-sm text-muted">{e.period} · {e.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-card bg-paper-dim p-6">
        <div class="mb-4 flex items-center gap-2 text-muted">
          <Icon name="lucide:languages" class="h-4 w-4" />
          <span class="font-mono text-xs uppercase tracking-[0.15em]">Languages</span>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            languages.map((l) => (
              <span class="rounded-pill bg-paper px-3.5 py-1.5 text-sm font-medium text-ink">
                {l.name} <span class="text-muted">· {l.level}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
