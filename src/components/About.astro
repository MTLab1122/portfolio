---
import { Icon } from "astro-icon/components";
import { person, education, languages } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const pillars = [
  {
    icon: "lucide:layout-template",
    title: "Precision UI Systems",
    desc: "Component tokens, fluid typography, Figma-level fidelity, and accessible interactions built to make products feel intentional.",
  },
  {
    icon: "lucide:zap",
    title: "Modern Architecture & Speed",
    desc: "Type-safe TypeScript, edge-ready Astro builds, Next.js full-stack capabilities, and sub-second load times with zero fluff.",
  },
  {
    icon: "lucide:shield-check",
    title: "Conversion & Credibility",
    desc: "Clear visual hierarchy, scannable case studies, and focused journeys that build trust with clients and collaborators.",
  },
];
---

<section id="about" class="border-t border-line px-5 py-16 sm:px-10 lg:py-20">
  <SectionHeading eyebrow="About Me" title="Design-minded builder. Clear thinker." />

  <div class="mt-12 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- Left Column: Story & Principles -->
    <div class="reveal rounded-card border border-line bg-paper-card p-6 sm:p-10 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-lime"></span>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-muted">The Approach</p>
      </div>

      <h3 class="mt-5 font-display text-2xl font-bold leading-tight text-ink sm:text-3xl">
        I create digital interfaces that look refined, communicate clearly, and help visitors decide faster.
      </h3>

      <p class="mt-4 text-base leading-relaxed text-ink/75 sm:text-lg">
        {person.summary}
      </p>

      <!-- 3 Engineering Pillars -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="group rounded-card border border-line/80 bg-paper p-5 transition-all duration-200 hover:-translate-y-1 hover:border-ink/30 hover:shadow-sm">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-lime text-ink transition-transform duration-200 group-hover:scale-105">
              <Icon name={pillar.icon} class="h-4 w-4" />
            </span>
            <h4 class="mt-3.5 font-display text-base font-semibold text-ink leading-snug">
              {pillar.title}
            </h4>
            <p class="mt-2 text-xs leading-relaxed text-ink/65">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Education & Credentials -->
    <div class="reveal space-y-5">
      <!-- Academic Honors -->
      <div class="rounded-card border border-line bg-paper-card p-6 sm:p-8 shadow-sm">
        <div class="mb-5 flex items-center justify-between border-b border-line pb-3">
          <div class="flex items-center gap-2 text-ink">
            <Icon name="lucide:graduation-cap" class="h-4 w-4 text-ink" />
            <h4 class="font-mono text-xs font-semibold uppercase tracking-[0.18em]">Education & Honors</h4>
          </div>
          <span class="rounded-pill bg-lime px-2.5 py-0.5 font-mono text-[0.62rem] font-bold text-ink">
            CGPA 3.87
          </span>
        </div>

        <ul class="space-y-4">
          {education.map((e) => (
            <li class="rounded-xl border border-line/50 bg-paper p-3.5 transition-colors hover:border-ink/30">
              <div class="flex items-start justify-between gap-2">
                <p class="font-display text-sm font-bold text-ink">{e.degree}</p>
                <span class="shrink-0 rounded bg-ink-soft px-2 py-0.5 font-mono text-[0.62rem] font-medium text-paper">
                  {e.detail}
                </span>
              </div>
              <p class="mt-1 text-xs text-muted">{e.school}</p>
              <p class="mt-0.5 font-mono text-[0.62rem] text-muted/80">{e.period}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Spoken Languages & Regional Fluency -->
      <div class="rounded-card border border-line bg-paper-card p-6 shadow-sm">
        <div class="mb-4 flex items-center gap-2 text-ink border-b border-line pb-3">
          <Icon name="lucide:languages" class="h-4 w-4 text-ink" />
          <h4 class="font-mono text-xs font-semibold uppercase tracking-[0.18em]">Spoken Languages</h4>
        </div>

        <div class="flex flex-wrap gap-2.5">
          {languages.map((l) => (
            <div class="inline-flex items-center gap-2 rounded-pill border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink shadow-2xs">
              <span>{l.name}</span>
              <span class="rounded-full bg-ink/10 px-2 py-0.5 font-mono text-[0.62rem] font-normal text-muted">
                {l.level}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
