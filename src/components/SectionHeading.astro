---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}
const { eyebrow, title, subtitle, align = "left", class: className = "" } = Astro.props;
---

<div class={`reveal ${align === "center" ? "text-center" : ""} ${className}`}>
  <div class={`inline-flex items-center gap-2 mb-3 ${align === "center" ? "justify-center" : ""}`}>
    <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
    <p class="font-mono text-xs tracking-[0.22em] uppercase text-muted">
      {eyebrow}
    </p>
  </div>
  <h2 class="story-title font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 max-w-2xl text-sm sm:text-base text-ink/70 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
