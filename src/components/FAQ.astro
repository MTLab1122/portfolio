---
import { Icon } from "astro-icon/components";
import { faqs, person } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section id="faq" class="border-t border-line px-5 py-16 sm:px-10 lg:py-20">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <SectionHeading
      eyebrow="AEO & Knowledge Verification"
      title="Direct answers to frequent questions."
      subtitle="Factual answers regarding Muhammad Talha's engineering focus, technical architecture, verified GitHub projects, and availability."
    />

    <a
      href="#contact"
      class="reveal inline-flex items-center gap-1.5 rounded-pill border border-ink/20 bg-paper px-4 py-2 text-xs font-semibold text-ink transition-colors hover:border-ink hover:bg-white"
    >
      <span>Ask a specific question</span>
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
    </a>
  </div>

  <div class="mt-12 grid gap-4 max-w-4xl">
    {
      faqs.map((faq, index) => (
        <details
          class="reveal group rounded-card border border-line bg-paper-card p-6 shadow-xs transition-all duration-200 hover:border-ink/40 hover:shadow-sm [&[open]]:bg-white [&[open]]:border-ink"
          open={index === 0}
        >
          <summary class="flex cursor-pointer items-center justify-between gap-4 list-none font-display text-lg font-bold text-ink sm:text-xl">
            <span>{faq.question}</span>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-paper border border-line transition-transform duration-200 group-open:rotate-180 group-open:bg-lime">
              <Icon name="lucide:chevron-down" class="h-4 w-4 text-ink" />
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-line/50 text-sm leading-relaxed text-ink/80 sm:text-base font-normal">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
