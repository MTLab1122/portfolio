---
import { Icon } from "astro-icon/components";
import { person, stats } from "../data/profile";
---

<section id="top" class="px-5 pb-14 pt-12 sm:px-10 sm:pt-16">
  <div class="grid items-center gap-10 lg:grid-cols-[1.08fr_0.92fr]">
    <div class="reveal">
      <p class="mb-5 font-mono text-xs uppercase tracking-[0.22em] text-muted">
        {person.role} — {person.location}
      </p>

      <h1 class="max-w-4xl font-display text-[2.6rem] font-bold leading-[0.96] tracking-[-0.05em] text-ink sm:text-6xl lg:text-[5.2rem]">
        I build digital experiences that feel premium and perform.
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/72 sm:text-lg">
        I design and build fast, conversion-focused websites for founders and businesses who need clarity, trust, and momentum.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="group inline-flex items-center gap-2 rounded-pill bg-ink px-6 py-3.5 text-sm font-semibold text-paper shadow-[0_14px_30px_rgba(20,21,15,0.2)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink-soft"
        >
          View projects
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href={person.resumeUrl}
          download
          class="inline-flex items-center gap-2 rounded-pill border border-ink/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-ink transition-all duration-200 hover:-translate-y-0.5 hover:border-ink"
        >
          Download CV
          <Icon name="lucide:download" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {stats.map((s) => (
          <div class="rounded-pill border border-line bg-paper px-3.5 py-2.5 shadow-[0_10px_25px_rgba(20,21,15,0.03)]">
            <span class="font-display text-sm font-bold text-ink">
              {s.value}
              <span class="font-normal text-muted">{s.suffix}</span>
            </span>
            <span class="ml-2 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="reveal relative">
      <div class="absolute -left-5 top-8 h-24 w-24 rounded-full bg-lime/60 blur-3xl" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-[2rem] border border-line bg-[#dfe5d4] p-3 shadow-[0_28px_70px_rgba(20,21,15,0.08)] transition-transform duration-200 hover:-translate-y-1 sm:p-4">
        <div class="absolute inset-x-5 top-5 z-10 flex items-center justify-between rounded-full border border-ink/10 bg-paper/80 px-3 py-2 backdrop-blur-sm">
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted">Available</span>
          <span class="inline-flex items-center gap-2 text-sm font-medium text-ink">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            Open to remote work
          </span>
        </div>
        <div class="overflow-hidden rounded-[1.6rem] border border-ink/8 bg-[#dfe5d4] shadow-[inset_0_1px_0_rgba(255,255,255,0.6)]">
          <img
            src={person.photo}
            alt={person.photoAlt}
            class="h-[28rem] w-full object-cover object-center drop-shadow-[0_18px_28px_rgba(0,0,0,0.16)] sm:h-[33rem] grayscale-[0.08] contrast-[1.04]"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
