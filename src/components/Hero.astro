---
import { Icon } from "astro-icon/components";
import { person, stats } from "../data/profile";

const rawBaseUrl = import.meta.env.BASE_URL ?? "/";
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;

const techStack = [
  { name: "Astro", icon: "lucide:rocket" },
  { name: "Next.js", icon: "lucide:layers" },
  { name: "TypeScript", icon: "lucide:code-2" },
  { name: "Tailwind CSS", icon: "lucide:sparkles" },
  { name: "Node.js", icon: "lucide:cpu" },
  { name: "Python", icon: "lucide:terminal" },
  { name: "MongoDB", icon: "lucide:database" },
  { name: "Figma UI/UX", icon: "lucide:pen-tool" },
  { name: "GSAP Motion", icon: "lucide:move" },
  { name: "Technical SEO", icon: "lucide:search" },
  { name: "Git Workflow", icon: "lucide:git-branch" },
];
---

<section id="top" class="relative px-5 pb-10 pt-10 sm:px-10 sm:pt-14 lg:pb-14">
  <div class="grid items-center gap-10 lg:grid-cols-[1.12fr_0.88fr] xl:gap-14">
    <!-- Left Hero Content -->
    <div class="reveal hero-copy">
      <!-- Status Badge -->
      <div class="mb-5 inline-flex flex-wrap items-center gap-2.5 rounded-pill border border-line bg-paper-card px-4 py-1.5 shadow-sm">
        <span class="pulse-beacon inline-block h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
        <span class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-ink">
          {person.availability}
        </span>
        <span class="hidden text-xs text-muted sm:inline">•</span>
        <span class="hidden font-mono text-[0.65rem] text-muted sm:inline">
          Charsadda, PK
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="max-w-4xl font-display text-[2.75rem] font-bold leading-[0.94] tracking-[-0.05em] text-ink sm:text-6xl lg:text-[5.4rem]">
        I build digital experiences that feel <span class="underline decoration-lime decoration-4 underline-offset-8">exceptional</span> and perform.
      </h1>

      <!-- Value Subtitle -->
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/75 sm:text-lg">
        Software engineer and frontend developer crafting fast, accessible, conversion-driven websites. Combining engineering rigor (3.87 CGPA) with modern design intuition to turn ideas into high-impact digital products.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3.5 hero-actions">
        <a
          href="#work"
          class="group inline-flex items-center gap-2.5 rounded-pill bg-ink px-7 py-3.5 text-sm font-semibold text-paper shadow-[0_12px_28px_rgba(20,21,15,0.22)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink-soft hover:shadow-[0_16px_36px_rgba(20,21,15,0.3)]"
        >
          <span>Explore selected work</span>
          <Icon name="lucide:arrow-down" class="h-4 w-4 transition-transform duration-200 group-hover:translate-y-0.5" />
        </a>

        <a
          href={`${baseUrl}${person.resumeUrl.replace(/^\/+/, "")}`}
          download
          class="group inline-flex items-center gap-2.5 rounded-pill border border-ink/20 bg-paper px-6 py-3.5 text-sm font-semibold text-ink transition-all duration-200 hover:-translate-y-0.5 hover:border-ink hover:bg-white hover:shadow-sm"
        >
          <Icon name="lucide:download" class="h-4 w-4 text-muted transition-colors group-hover:text-ink" />
          <span>Download CV</span>
          <span class="font-mono text-[0.62rem] text-muted">120 KB</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-ink/70 transition-colors hover:text-ink"
        >
          <span>Direct contact</span>
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </a>
      </div>

      <!-- Animated Key Stat Counters -->
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="rounded-card border border-line bg-paper-card p-3.5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-ink/30">
            <div class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
              <span class="stat-counter" data-target={s.value}>{s.value}</span>
              <span class="text-sm font-normal text-muted">{s.suffix}</span>
            </div>
            <p class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted leading-tight">
              {s.label}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Profile Showpiece -->
    <div class="reveal relative">
      <!-- Ambient light effect -->
      <div class="absolute -left-6 -top-6 h-40 w-40 rounded-full bg-lime/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -right-6 -bottom-6 h-40 w-40 rounded-full bg-emerald-500/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <!-- Profile Card with 3D tilt -->
      <div class="card-3d relative overflow-hidden rounded-[2.2rem] border border-line bg-[#dfe5d4] p-3.5 shadow-[0_30px_70px_rgba(20,21,15,0.1)] transition-transform duration-200 sm:p-5">
        <div class="card-glare"></div>

        <!-- Floating live availability badge -->
        <div class="absolute inset-x-6 top-6 z-10 flex items-center justify-between rounded-full border border-ink/10 bg-paper/90 px-4 py-2.5 backdrop-blur-md shadow-sm">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.14em] text-ink">Active & Ready</span>
          </div>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-muted">
            Charsadda, PK
          </span>
        </div>

        <!-- Image frame with crisp shadow -->
        <div class="overflow-hidden rounded-[1.75rem] border border-ink/10 bg-[#dfe5d4] shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
          <img
            src={`${baseUrl}${person.photo.replace(/^\/+/, "")}`}
            alt={person.photoAlt}
            width="512"
            height="512"
            class="h-[28rem] w-full object-cover object-center drop-shadow-[0_20px_30px_rgba(0,0,0,0.18)] sm:h-[32rem] transition-transform duration-700 hover:scale-[1.02]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!-- Bottom Tag Overlay -->
        <div class="mt-3 flex items-center justify-between px-2 text-[0.68rem] font-mono uppercase tracking-[0.14em] text-muted">
          <span>{person.name}</span>
          <span>BSE Abasyn '27</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Stack Infinite Marquee Ribbon -->
  <div class="mt-14 border-t border-line/80 pt-6">
    <div class="flex items-center gap-4">
      <span class="shrink-0 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted">
        Core Toolkit //
      </span>
      <div class="marquee-container flex-1">
        <div class="marquee-content flex items-center gap-6 py-1">
          {techStack.concat(techStack).map((item) => (
            <div class="inline-flex shrink-0 items-center gap-2 rounded-pill border border-line bg-paper px-3.5 py-1.5 text-xs font-medium text-ink/80 transition-colors hover:border-ink hover:text-ink">
              <Icon name={item.icon} class="h-3.5 w-3.5 text-muted" />
              <span>{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
