---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

import { person } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = person.seoTitle,
  description = person.seoDescription,
  image = "/og-image.svg",
  structuredData,
} = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL ?? "/";
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
const effectiveSite = (Astro.site?.toString() ?? person.productionUrl).replace(/\/+$/, "");
const canonicalURL = new URL(Astro.url.pathname, `${effectiveSite}/`);
const ogImage = new URL(image.replace(/^\/+/, ""), `${effectiveSite}/`).toString();
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/portfolio" || Astro.url.pathname === "/portfolio/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.role,
  description: person.seoDescription,
  image: new URL(person.photo.replace(/^\/+/, ""), `${effectiveSite}/`).toString(),
  url: effectiveSite,
  email: `mailto:${person.email}`,
  telephone: person.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Charsadda",
    addressRegion: "Khyber Pakhtunkhwa",
    addressCountry: "PK",
  },
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Abasyn University Peshawar",
  },
  sameAs: [person.github, person.linkedin, person.productionUrl],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: person.siteName,
  url: effectiveSite,
  description: person.seoDescription,
  publisher: {
    "@type": "Person",
    name: person.name,
  },
  inLanguage: "en-US",
};

const profilePageSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      mainEntity: personSchema,
      headline: `${person.name} — ${person.role}`,
      url: canonicalURL.toString(),
    }
  : null;

const schemas = [
  personSchema,
  websiteSchema,
  ...(profilePageSchema ? [profilePageSchema] : []),
  ...(structuredData ? [structuredData] : []),
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={person.keywords.join(", ")} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#14150f" />
    <meta name="application-name" content={person.siteName} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={person.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@mtlabs1122" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body class="antialiased selection:bg-lime selection:text-ink">
    <a href="#top" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-5 focus:py-2.5 focus:bg-lime focus:text-ink focus:font-semibold focus:rounded-pill focus:shadow-2xl">
      Skip to main content
    </a>

    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <div class="cursor-orb" data-cursor-orb aria-hidden="true"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true"></div>

    <div id="portfolio-toast" class="toast-notice" role="status" aria-live="polite">
      <span class="inline-block h-2 w-2 rounded-full bg-lime"></span>
      <span id="toast-message">Notification message</span>
    </div>

    <slot />

    <script>
      declare global {
        interface Window {
          showToast: (message: string, duration?: number) => void;
        }
      }

      // Toast notification helper
      let toastTimer: number | undefined;
      window.showToast = (message: string, duration = 3000) => {
        const toast = document.getElementById("portfolio-toast");
        const msgEl = document.getElementById("toast-message");
        if (!toast || !msgEl) return;
        msgEl.textContent = message;
        toast.classList.add("is-visible");
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove("is-visible");
        }, duration);
      };

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const finePointer = window.matchMedia("(pointer: fine)").matches;

      // Reveal animation observer
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll(".reveal").forEach((element, index) => {
        const el = element as HTMLElement;
        el.style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 60}ms`);
        revealObserver.observe(el);
      });

      // Story title words splitting & animation
      document.querySelectorAll<HTMLElement>(".story-title").forEach((heading) => {
        if (!heading.dataset.split) {
          heading.dataset.split = "true";
          const words = heading.textContent?.trim().split(/\s+/) ?? [];
          heading.innerHTML = words
            .map((word, i) => `<span class="story-word" style="--word-idx: ${i}">${word}</span>`)
            .join(" ");
        }
      });

      // Scroll progress tracking
      const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
      let progressFrame = 0;
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        progress?.style.setProperty(
          "--scroll-progress",
          `${scrollable > 0 ? window.scrollY / scrollable : 0}`
        );
        progressFrame = 0;
      };
      updateProgress();
      window.addEventListener("scroll", () => {
        if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
      }, { passive: true });

      // Parallax coordinate tracking
      const shell = document.querySelector(".workflow-shell") as HTMLElement | null;
      if (!reduceMotion && shell) {
        let pointerFrame = 0;
        let pointerX = 0;
        let pointerY = 0;
        const updatePointer = () => {
          shell.style.setProperty("--pointer-x", `${pointerX}`);
          shell.style.setProperty("--pointer-y", `${pointerY}`);
          pointerFrame = 0;
        };
        window.addEventListener("pointermove", (event) => {
          pointerX = (event.clientX / window.innerWidth - 0.5) * 2;
          pointerY = (event.clientY / window.innerHeight - 0.5) * 2;
          if (!pointerFrame) pointerFrame = requestAnimationFrame(updatePointer);
        }, { passive: true });
      }

      // Smooth custom cursor for precision mouse pointers
      if (!reduceMotion && finePointer) {
        const orb = document.querySelector<HTMLElement>("[data-cursor-orb]");
        const ring = document.querySelector<HTMLElement>("[data-cursor-ring]");
        if (orb && ring) {
          let mouseX = -100;
          let mouseY = -100;
          let ringX = -100;
          let ringY = -100;
          let isMoving = false;

          window.addEventListener("pointermove", (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            orb.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
            if (!isMoving) {
              isMoving = true;
              renderRing();
            }
          }, { passive: true });

          const renderRing = () => {
            ringX += (mouseX - ringX) * 0.16;
            ringY += (mouseY - ringY) * 0.16;
            ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
            if (Math.hypot(mouseX - ringX, mouseY - ringY) > 0.1) {
              requestAnimationFrame(renderRing);
            } else {
              isMoving = false;
            }
          };

          const hoverTargets = 'a, button, input, textarea, select, [role="button"], [data-hover]';
          document.addEventListener("pointerover", (e) => {
            const target = (e.target as HTMLElement)?.closest(hoverTargets);
            if (target) {
              document.body.classList.add("cursor-hovering");
            }
          });
          document.addEventListener("pointerout", (e) => {
            const target = (e.target as HTMLElement)?.closest(hoverTargets);
            if (target) {
              document.body.classList.remove("cursor-hovering");
            }
          });
        }
      }
    </script>
  </body>
</html>
