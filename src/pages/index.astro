---
import Layout from "../layouts/Layout.astro";
import IconRail from "../components/IconRail.astro";
import MobileNav from "../components/MobileNav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Work from "../components/Work.astro";
import Experience from "../components/Experience.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { blogPosts, person } from "../data/profile";
import { Icon } from "astro-icon/components";

const featuredBlog = blogPosts.find((post) => post.featured) ?? blogPosts[0];
const rawBaseUrl = import.meta.env.BASE_URL ?? "/";
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<Layout
  title={`${person.name} — ${person.role}`}
  description={person.seoDescription}
>
  <div class="workflow-shell min-h-screen p-2 sm:p-4 lg:p-6" style="--pointer-x: 0; --pointer-y: 0;">
    <div class="workflow-bg" aria-hidden="true">
      <div class="workflow-grid"></div>
      <div class="workflow-orbit orbit-a"></div>
      <div class="workflow-orbit orbit-b"></div>

      <!-- Architectural ambient labels -->
      <div class="absolute left-8 top-8 hidden font-mono text-[0.62rem] uppercase tracking-[0.24em] text-white/20 xl:block">
        STUDIO PORTFOLIO // {new Date().getFullYear()}
      </div>
      <div class="absolute right-8 top-8 hidden font-mono text-[0.62rem] uppercase tracking-[0.24em] text-white/20 xl:block">
        34.1481° N, 71.7406° E • CHARSADDA, PK
      </div>
    </div>

    <div class="mx-auto max-w-[1520px] overflow-hidden rounded-[2.25rem] border border-white/10 bg-paper/96 shadow-[0_35px_90px_rgba(0,0,0,0.4)] backdrop-blur-md lg:flex lg:items-stretch">
      <IconRail />

      <div class="min-w-0 flex-1">
        <MobileNav />
        <main id="main-content">
          <Hero />
          <About />
          <Skills />
          <Work />
          <Experience />

          <!-- Blog Preview Section -->
          <section id="blog-preview" class="border-t border-line px-5 py-16 sm:px-10">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div class="reveal">
                <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">Writing & Insights</p>
                <h2 class="mt-3 story-title font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl">
                  Lessons from the frontend edge.
                </h2>
              </div>
              <a
                href={`${baseUrl}blog`}
                class="reveal inline-flex items-center gap-2 rounded-pill border border-ink/20 bg-paper px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-200 hover:-translate-y-0.5 hover:border-ink hover:bg-white"
              >
                Explore all articles
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            </div>

            <div class="reveal mt-8 overflow-hidden rounded-card border border-line bg-paper-card shadow-sm transition-transform duration-300 hover:shadow-md">
              <div class="grid gap-0 md:grid-cols-[1.1fr_0.9fr]">
                <div class="relative overflow-hidden bg-ink/5">
                  <img
                    src={`${baseUrl}${featuredBlog.image.replace(/^\/+/, "")}`}
                    alt={featuredBlog.title}
                    class="h-64 w-full object-cover transition-transform duration-500 hover:scale-105 md:h-full"
                    loading="lazy"
                  />
                  <div class="absolute left-4 top-4 rounded-pill bg-ink/80 px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-lime backdrop-blur-sm">
                    Featured article
                  </div>
                </div>
                <div class="flex flex-col justify-center p-6 sm:p-10">
                  <div class="flex items-center gap-2 text-[0.68rem] font-mono uppercase tracking-[0.18em] text-muted">
                    <span class="rounded bg-paper px-2 py-0.5 font-semibold text-ink">{featuredBlog.category}</span>
                    <span>•</span>
                    <span>{featuredBlog.readTime}</span>
                  </div>
                  <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
                    <a href={`${baseUrl}blog/${featuredBlog.slug}`} class="transition-colors hover:text-ink/75">
                      {featuredBlog.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink/70 sm:text-base">
                    {featuredBlog.excerpt}
                  </p>
                  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-line/60 pt-4">
                    <div class="flex items-center gap-2">
                      <span class="grid h-6 w-6 place-items-center rounded-full bg-lime text-[0.65rem] font-bold text-ink">
                        MT
                      </span>
                      <span class="text-xs font-medium text-ink">{featuredBlog.author}</span>
                    </div>
                    <a
                      href={`${baseUrl}blog/${featuredBlog.slug}`}
                      class="inline-flex items-center gap-2 rounded-pill bg-ink px-5 py-2.5 text-xs font-semibold text-paper transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink-soft hover:shadow-md"
                    >
                      Read full article
                      <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <FAQ />
          <Contact />
        </main>
        <Footer />
      </div>
    </div>
  </div>

  <script>
    import "../scripts/home-motion";
  </script>
</Layout>
