---
import Layout from "../layouts/Layout.astro";
import { person } from "../data/profile";
---

<Layout title={`Page not found | ${person.name}`} description="The page you requested could not be found. Return to Muhammad Talha's software engineer portfolio.">
  <main class="grid min-h-screen place-items-center bg-sage px-5 py-16 text-center">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">404 · Not found</p>
      <h1 class="mt-4 font-display text-5xl font-bold tracking-tight text-ink">That page moved.</h1>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-ink/70">The work is still here. Start from the portfolio homepage or explore the latest notes.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={import.meta.env.BASE_URL} class="inline-flex min-h-12 items-center rounded-pill bg-ink px-5 py-3 text-sm font-semibold text-paper">Back home</a>
        <a href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}blog`} class="inline-flex min-h-12 items-center rounded-pill border border-ink/20 px-5 py-3 text-sm font-semibold text-ink">Read the blog</a>
      </div>
    </div>
  </main>
</Layout>