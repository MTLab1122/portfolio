---
import Layout from "../layouts/Layout.astro";
import { person } from "../data/profile";
import { Icon } from "astro-icon/components";

const rawBaseUrl = import.meta.env.BASE_URL ?? "/";
const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
---

<Layout title={`Page not found | ${person.name}`} description="The requested page could not be located. Return to Muhammad Talha's portfolio.">
  <main class="grid min-h-screen place-items-center px-4 py-16 text-center bg-[#121512]">
    <div class="max-w-md rounded-[2.25rem] border border-white/10 bg-paper p-8 sm:p-12 shadow-[0_30px_90px_rgba(0,0,0,0.4)]">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-lime text-ink">
        <Icon name="lucide:alert-circle" class="h-8 w-8" />
      </div>
      
      <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">Error 404 // Not Found</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">That page moved.</h1>
      
      <p class="mx-auto mt-4 text-sm leading-relaxed text-ink/75">
        The route you requested doesn't exist or was relocated. The portfolio and case studies are still here.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a
          href={baseUrl}
          class="inline-flex items-center justify-center gap-2 rounded-pill bg-ink px-6 py-3 text-xs font-bold text-paper hover:bg-ink-soft transition-colors"
        >
          <Icon name="lucide:home" class="h-3.5 w-3.5" />
          <span>Back to homepage</span>
        </a>
        <a
          href={`${baseUrl}blog`}
          class="inline-flex items-center justify-center gap-2 rounded-pill border border-ink/20 bg-paper px-6 py-3 text-xs font-bold text-ink hover:border-ink transition-colors"
        >
          <Icon name="lucide:book-open" class="h-3.5 w-3.5" />
          <span>Explore blog</span>
        </a>
      </div>
    </div>
  </main>
</Layout>